---
import FormContainer from '../components/containers/FormContainer.astro';
import Layout from '../layouts/Layout.astro';
import CVLivePreview from '../components/preview/CVLivePreview.tsx';
import TabSwitcher from '../components/ui/TabSwitcher.astro';
import CVCustomization from '../components/editor/CVCustomization.tsx';
---

<Layout>
	<!-- Top Bar -->
	<header class="sticky top-0 z-50 backdrop-blur-md bg-white/70 border-b border-gray-200/60">
		<div class="max-w-screen-2xl mx-auto px-6 py-4 flex items-center justify-between">
			<div class="flex items-center gap-3">
				<div class="h-8 w-8 rounded-lg bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
					</svg>
				</div>
				<h1 class="text-lg font-semibold text-gray-800 tracking-tight">Step to Work</h1>
			</div>
			<span class="text-xs font-medium text-gray-400 tracking-wide uppercase hidden sm:block">CV Builder</span>
		</div>
	</header>

	<!-- Main Content: Side by Side -->
	<main class="max-w-screen-2xl mx-auto px-6 py-8">
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
			<!-- Left: Form Panel -->
			<section class="flex flex-col">
				<div class="mb-5">
					<TabSwitcher />
				</div>
				
				<div id="content-panel" class="transition-opacity duration-300 opacity-100">
					<FormContainer />
				</div>
				<div id="customization-panel" class="hidden transition-opacity duration-300 opacity-0">
					<div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-2">
						<CVCustomization client:only="react" />
					</div>
				</div>
			</section>

			<!-- Right: Preview Panel -->
			<section class="lg:sticky lg:top-24 lg:h-fit">
				<div>
					<CVLivePreview client:only="react" />
				</div>
			</section>
		</div>
	</main>
</Layout>

<script>
  import { activeTabStore } from '../stores/uiStore';

  const contentPanel = document.getElementById('content-panel');
  const customizationPanel = document.getElementById('customization-panel');

  let firstRun = true;
  activeTabStore.subscribe((tab) => {
    const isContent = tab === 'content';
    const show = isContent ? contentPanel : customizationPanel;
    const hide = isContent ? customizationPanel : contentPanel;

    if (firstRun) {
      show?.classList.remove('hidden', 'opacity-0');
      show?.classList.add('opacity-100');
      hide?.classList.add('hidden', 'opacity-0');
      hide?.classList.remove('opacity-100');
      firstRun = false;
      return;
    }

    // Fade out current panel
    hide?.classList.remove('opacity-100');
    hide?.classList.add('opacity-0');

    // Wait for fade out transition (300ms)
    setTimeout(() => {
      hide?.classList.add('hidden');
      show?.classList.remove('hidden');
      
      // Request animation frame to trigger fade in after display change
      requestAnimationFrame(() => {
        setTimeout(() => {
          show?.classList.remove('opacity-0');
          show?.classList.add('opacity-100');
        }, 10);
      });
    }, 300);
  });
</script>
