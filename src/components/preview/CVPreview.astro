---
// src/components/preview/CVPreview.astro
// ATS-Friendly CV Preview — clean, simple, parseable layout
---

<div id="cv-preview" class="bg-white max-w-[794px] mx-auto shadow-lg border border-gray-200" style="font-family: 'Times New Roman', Georgia, serif; color: #1a1a1a; line-height: 1.4;">

  <!-- ===== HEADER: Name, Title, Contact ===== -->
  <div style="padding: 32px 40px 16px 40px; text-align: center;">
    <h1 id="p-fullName" style="font-size: 24px; font-weight: 700; margin: 0 0 2px 0; letter-spacing: 0.5px; text-transform: uppercase;">Nama Lengkap</h1>
    <p id="p-jobTitle" style="font-size: 14px; margin: 0 0 8px 0; color: #444;">Posisi Pekerjaan</p>
    <div id="p-contact" style="font-size: 11px; color: #555; display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 12px;"></div>
    <div id="p-links" style="font-size: 11px; color: #555; display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 12px; margin-top: 2px;"></div>
  </div>

  <!-- ===== SUMMARY ===== -->
  <div id="section-summary" style="padding: 0 40px; display: none;">
    <h2 style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1.5px solid #1a1a1a; padding-bottom: 3px; margin: 12px 0 6px 0;">Ringkasan Profesional</h2>
    <p id="p-summary" style="font-size: 11.5px; margin: 0; text-align: justify;"></p>
  </div>

  <!-- ===== WORK EXPERIENCE ===== -->
  <div id="section-work" style="padding: 0 40px; display: none;">
    <h2 style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1.5px solid #1a1a1a; padding-bottom: 3px; margin: 14px 0 6px 0;">Pengalaman Kerja</h2>
    <div id="p-workList"></div>
  </div>

  <!-- ===== EDUCATION ===== -->
  <div id="section-education" style="padding: 0 40px; display: none;">
    <h2 style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1.5px solid #1a1a1a; padding-bottom: 3px; margin: 14px 0 6px 0;">Pendidikan</h2>
    <div id="p-eduList"></div>
  </div>

  <!-- ===== SKILLS ===== -->
  <div id="section-skills" style="padding: 0 40px; display: none;">
    <h2 style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1.5px solid #1a1a1a; padding-bottom: 3px; margin: 14px 0 6px 0;">Keahlian</h2>
    <div id="p-skillsList" style="font-size: 11.5px;"></div>
  </div>

  <!-- ===== PROJECTS ===== -->
  <div id="section-projects" style="padding: 0 40px; display: none;">
    <h2 style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1.5px solid #1a1a1a; padding-bottom: 3px; margin: 14px 0 6px 0;">Proyek</h2>
    <div id="p-projectsList"></div>
  </div>

  <!-- ===== CERTIFICATIONS ===== -->
  <div id="section-certs" style="padding: 0 40px; display: none;">
    <h2 style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1.5px solid #1a1a1a; padding-bottom: 3px; margin: 14px 0 6px 0;">Sertifikasi</h2>
    <div id="p-certsList"></div>
  </div>

  <!-- ===== ORGANIZATION EXPERIENCE ===== -->
  <div id="section-org" style="padding: 0 40px; display: none;">
    <h2 style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1.5px solid #1a1a1a; padding-bottom: 3px; margin: 14px 0 6px 0;">Pengalaman Organisasi</h2>
    <div id="p-orgList"></div>
  </div>

  <!-- ===== VOLUNTEER EXPERIENCE ===== -->
  <div id="section-volunteer" style="padding: 0 40px; display: none;">
    <h2 style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1.5px solid #1a1a1a; padding-bottom: 3px; margin: 14px 0 6px 0;">Pengalaman Sukarelawan</h2>
    <div id="p-volList"></div>
  </div>

  <!-- ===== LANGUAGES ===== -->
  <div id="section-languages" style="padding: 0 40px; display: none;">
    <h2 style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1.5px solid #1a1a1a; padding-bottom: 3px; margin: 14px 0 6px 0;">Bahasa</h2>
    <div id="p-langList" style="font-size: 11.5px;"></div>
  </div>

  <!-- ===== REFERENCES ===== -->
  <div id="section-refs" style="padding: 0 40px 32px 40px; display: none;">
    <h2 style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1.5px solid #1a1a1a; padding-bottom: 3px; margin: 14px 0 6px 0;">Referensi</h2>
    <div id="p-refsList"></div>
  </div>

  <!-- Bottom padding fallback -->
  <div style="padding-bottom: 24px;"></div>
</div>

<script>
  import { cvStore } from '../../stores/cvStores';
  import { cvStyleStore } from '../../stores/cvStores';
  import type { CVData } from '../../stores/cvStores';

  // Helper: format "2024-06" → "Jun 2024"
  function fmtDate(d: string | null | undefined): string {
    if (!d) return 'Sekarang';
    const [y, m] = d.split('-');
    const months = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
    return `${months[parseInt(m, 10) - 1]} ${y}`;
  }

  // Helper: toggle section visibility
  function showSection(id: string, visible: boolean) {
    const el = document.getElementById(id);
    if (el) el.style.display = visible ? 'block' : 'none';
  }

  function render(data: CVData) {
    const p = data.personalInfo;

    // --- Header ---
    const nameEl = document.getElementById('p-fullName');
    const titleEl = document.getElementById('p-jobTitle');
    if (nameEl) nameEl.textContent = p.fullName || 'Nama Lengkap';
    if (titleEl) titleEl.textContent = p.jobTitle || 'Posisi Pekerjaan';

    // Contact line
    const contactEl = document.getElementById('p-contact');
    if (contactEl) {
      const parts: string[] = [];
      if (p.email) parts.push(p.email);
      if (p.phone) parts.push(p.phone);
      if (p.location) parts.push(p.location);
      contactEl.innerHTML = parts.map(t => `<span>${t}</span>`).join('<span style="color:#999">|</span>');
    }

    // Links line
    const linksEl = document.getElementById('p-links');
    if (linksEl) {
      const links: string[] = [];
      if (p.linkedin) links.push(p.linkedin);
      if (p.github) links.push(p.github);
      if (p.portfolio) links.push(p.portfolio);
      linksEl.innerHTML = links.map(u => `<a href="${u}" style="color:#2563eb; text-decoration:none;">${u}</a>`).join('<span style="color:#999">|</span>');
    }

    // --- Summary ---
    const summaryEl = document.getElementById('p-summary');
    if (summaryEl) summaryEl.textContent = p.summary;
    showSection('section-summary', !!p.summary);

    // --- Work Experience ---
    const workList = document.getElementById('p-workList');
    if (workList) {
      workList.innerHTML = data.workExperience.map(w => `
        <div style="margin-bottom: 10px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline;">
            <strong style="font-size: 12px;">${w.jobTitle}</strong>
            <span style="font-size: 11px; color: #555;">${fmtDate(w.startDate)} — ${w.isCurrentJob ? 'Sekarang' : fmtDate(w.endDate)}</span>
          </div>
          <div style="font-size: 11.5px; font-style: italic; color: #333;">${w.company}${w.location ? ', ' + w.location : ''}</div>
          ${w.responsibilities.length ? `<ul style="margin: 3px 0 0 16px; padding: 0; font-size: 11.5px;">${w.responsibilities.map(r => `<li style="margin-bottom: 1px;">${r}</li>`).join('')}</ul>` : ''}
        </div>
      `).join('');
    }
    showSection('section-work', data.workExperience.length > 0);

    // --- Education ---
    const eduList = document.getElementById('p-eduList');
    if (eduList) {
      eduList.innerHTML = data.education.map(e => `
        <div style="margin-bottom: 10px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline;">
            <strong style="font-size: 12px;">${e.degree}</strong>
            <span style="font-size: 11px; color: #555;">${fmtDate(e.startDate)} — ${fmtDate(e.endDate)}</span>
          </div>
          <div style="font-size: 11.5px; font-style: italic; color: #333;">${e.institution}${e.location ? ', ' + e.location : ''}</div>
          ${e.gpa ? `<div style="font-size: 11px; color: #444;">IPK: ${e.gpa}${e.maxGpa ? ' / ' + e.maxGpa : ''}</div>` : ''}
          ${e.relevantCoursework.length ? `<div style="font-size: 11px; color: #444;">Mata Kuliah: ${e.relevantCoursework.join(', ')}</div>` : ''}
        </div>
      `).join('');
    }
    showSection('section-education', data.education.length > 0);

    // --- Skills ---
    const skillsList = document.getElementById('p-skillsList');
    const s = data.skills;
    const hasSkills = Object.values(s).some(arr => arr.length > 0);
    if (skillsList) {
      const skillLines: string[] = [];
      const labels: Record<string, string> = {
        programmingLanguages: 'Bahasa Pemrograman',
        frameworksAndLibraries: 'Framework & Library',
        tools: 'Tools',
        databases: 'Database',
        testing: 'Testing',
        others: 'Lainnya',
      };
      for (const [key, label] of Object.entries(labels)) {
        const arr = s[key as keyof typeof s];
        if (arr.length > 0) {
          skillLines.push(`<div style="margin-bottom: 2px;"><strong>${label}:</strong> ${arr.join(', ')}</div>`);
        }
      }
      skillsList.innerHTML = skillLines.join('');
    }
    showSection('section-skills', hasSkills);

    // --- Projects ---
    const projectsList = document.getElementById('p-projectsList');
    if (projectsList) {
      projectsList.innerHTML = data.projects.map(proj => `
        <div style="margin-bottom: 10px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline;">
            <strong style="font-size: 12px;">${proj.name}</strong>
            ${proj.url ? `<a href="${proj.url}" style="font-size: 10px; color: #2563eb; text-decoration: none;">${proj.url}</a>` : ''}
          </div>
          <div style="font-size: 11.5px; color: #333;">${proj.description}</div>
          ${proj.techStack.length ? `<div style="font-size: 11px; color: #444; margin-top: 1px;"><em>Tech: ${proj.techStack.join(', ')}</em></div>` : ''}
          ${proj.highlights.length ? `<ul style="margin: 3px 0 0 16px; padding: 0; font-size: 11.5px;">${proj.highlights.map(h => `<li style="margin-bottom: 1px;">${h}</li>`).join('')}</ul>` : ''}
        </div>
      `).join('');
    }
    showSection('section-projects', data.projects.length > 0);

    // --- Certifications ---
    const certsList = document.getElementById('p-certsList');
    if (certsList) {
      certsList.innerHTML = data.certifications.map(c => `
        <div style="margin-bottom: 6px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline;">
            <strong style="font-size: 12px;">${c.name}</strong>
            <span style="font-size: 11px; color: #555;">${fmtDate(c.issueDate)}${c.expiryDate ? ' — ' + fmtDate(c.expiryDate) : ''}</span>
          </div>
          <div style="font-size: 11.5px; font-style: italic; color: #333;">${c.issuer}</div>
        </div>
      `).join('');
    }
    showSection('section-certs', data.certifications.length > 0);

    // --- Organization Experience ---
    const orgList = document.getElementById('p-orgList');
    if (orgList) {
      orgList.innerHTML = data.organizationExperience.map(o => `
        <div style="margin-bottom: 10px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline;">
            <strong style="font-size: 12px;">${o.role}</strong>
            <span style="font-size: 11px; color: #555;">${fmtDate(o.startDate)} — ${fmtDate(o.endDate)}</span>
          </div>
          <div style="font-size: 11.5px; font-style: italic; color: #333;">${o.organization}</div>
          ${o.description ? `<p style="font-size: 11.5px; margin: 3px 0 0 0;">${o.description}</p>` : ''}
        </div>
      `).join('');
    }
    showSection('section-org', data.organizationExperience.length > 0);

    // --- Volunteer Experience ---
    const volList = document.getElementById('p-volList');
    if (volList) {
      volList.innerHTML = data.volunteerExperience.map(v => `
        <div style="margin-bottom: 10px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline;">
            <strong style="font-size: 12px;">${v.role}</strong>
            <span style="font-size: 11px; color: #555;">${fmtDate(v.startDate)} — ${fmtDate(v.endDate)}</span>
          </div>
          <div style="font-size: 11.5px; font-style: italic; color: #333;">${v.organization}</div>
          ${v.description ? `<p style="font-size: 11.5px; margin: 3px 0 0 0;">${v.description}</p>` : ''}
        </div>
      `).join('');
    }
    showSection('section-volunteer', data.volunteerExperience.length > 0);

    // --- Languages ---
    const langList = document.getElementById('p-langList');
    if (langList) {
      langList.innerHTML = data.languages.map(l =>
        `<span style="margin-right: 16px;"><strong>${l.language}</strong> — ${l.proficiency}</span>`
      ).join('');
    }
    showSection('section-languages', data.languages.length > 0);

    // --- References ---
    const refsList = document.getElementById('p-refsList');
    if (refsList) {
      refsList.innerHTML = data.references.map(r => `
        <div style="margin-bottom: 8px; font-size: 11.5px;">
          <strong>${r.name}</strong> — ${r.jobTitle}, ${r.company}<br/>
          <span style="color: #555;">${r.relationship} · ${r.email} · ${r.phone}</span>
        </div>
      `).join('');
    }
    showSection('section-refs', data.references.length > 0);
  }

  // Subscribe and render on every change
  cvStore.subscribe(render);

  // Subscribe to style changes (font, etc.)
  cvStyleStore.subscribe(style => {
    const preview = document.getElementById('cv-preview');
    if (preview) {
      preview.style.fontFamily = style.fontFamily;
    }
  });
</script>
