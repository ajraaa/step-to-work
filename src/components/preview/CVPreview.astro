---
// src/components/preview/CVPreview.astro
---

<div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 min-h-[400px]">
  <div class="space-y-6">
    <!-- Header: Name & Job Title -->
    <div class="text-center border-b pb-6 border-gray-100">
      <h1 id="preview-fullName" class="text-3xl font-bold text-gray-800 tracking-tight">Nama Lengkap</h1>
      <p id="preview-jobTitle" class="text-lg text-blue-600 font-medium mt-1">Posisi Pekerjaan</p>
    </div>

    <!-- Contact Info -->
    <div class="flex flex-wrap justify-center gap-4 text-sm text-gray-600">
      <div id="preview-email-container" class="flex items-center gap-1.5 hidden">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
        <span id="preview-email"></span>
      </div>
      <div id="preview-phone-container" class="flex items-center gap-1.5 hidden">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
        <span id="preview-phone"></span>
      </div>
      <div id="preview-location-container" class="flex items-center gap-1.5 hidden">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
        <span id="preview-location"></span>
      </div>
    </div>

    <!-- Links: LinkedIn, GitHub, Portfolio -->
    <div class="flex flex-wrap justify-center gap-4 text-sm">
      <a id="preview-linkedin-container" href="#" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-blue-600 hover:text-blue-800 transition-colors hidden">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        <span id="preview-linkedin">LinkedIn</span>
      </a>
      <a id="preview-github-container" href="#" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-gray-700 hover:text-gray-900 transition-colors hidden">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
        <span id="preview-github">GitHub</span>
      </a>
      <a id="preview-portfolio-container" href="#" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-indigo-600 hover:text-indigo-800 transition-colors hidden">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
        <span id="preview-portfolio">Portfolio</span>
      </a>
    </div>

    <!-- Summary -->
    <div id="preview-summary-container" class="hidden">
      <h3 class="text-sm font-bold text-gray-800 uppercase tracking-wider mb-2">Ringkasan Profesional</h3>
      <p id="preview-summary" class="text-gray-600 leading-relaxed text-sm whitespace-pre-line"></p>
    </div>
  </div>
</div>

<script>
  import { cvStore } from '../../stores/cvStores';

  const els = {
    fullName: document.getElementById('preview-fullName'),
    jobTitle: document.getElementById('preview-jobTitle'),
    email: document.getElementById('preview-email'),
    phone: document.getElementById('preview-phone'),
    location: document.getElementById('preview-location'),
    summary: document.getElementById('preview-summary'),
    linkedin: document.getElementById('preview-linkedin'),
    github: document.getElementById('preview-github'),
    portfolio: document.getElementById('preview-portfolio'),
    
    // Containers
    emailContainer: document.getElementById('preview-email-container'),
    phoneContainer: document.getElementById('preview-phone-container'),
    locationContainer: document.getElementById('preview-location-container'),
    summaryContainer: document.getElementById('preview-summary-container'),
    linkedinContainer: document.getElementById('preview-linkedin-container') as HTMLAnchorElement | null,
    githubContainer: document.getElementById('preview-github-container') as HTMLAnchorElement | null,
    portfolioContainer: document.getElementById('preview-portfolio-container') as HTMLAnchorElement | null,
  };

  cvStore.subscribe((data) => {
    const p = data.personalInfo;

    // Teks Dasar
    if (els.fullName) els.fullName.textContent = p.fullName || 'Nama Lengkap';
    if (els.jobTitle) els.jobTitle.textContent = p.jobTitle || 'Posisi Pekerjaan';
    if (els.email) els.email.textContent = p.email;
    if (els.phone) els.phone.textContent = p.phone;
    if (els.location) els.location.textContent = p.location;
    if (els.summary) els.summary.textContent = p.summary;

    // Links
    if (els.linkedin) els.linkedin.textContent = 'LinkedIn';
    if (els.linkedinContainer) els.linkedinContainer.href = p.linkedin || '#';
    if (els.github) els.github.textContent = 'GitHub';
    if (els.githubContainer) els.githubContainer.href = p.github || '#';
    if (els.portfolio) els.portfolio.textContent = 'Portfolio';
    if (els.portfolioContainer) els.portfolioContainer.href = p.portfolio || '#';

    // Menyembunyikan elemen jika teksnya kosong menggunakan Tailwind utility .hidden
    if (els.emailContainer) els.emailContainer.classList.toggle('hidden', !p.email);
    if (els.phoneContainer) els.phoneContainer.classList.toggle('hidden', !p.phone);
    if (els.locationContainer) els.locationContainer.classList.toggle('hidden', !p.location);
    if (els.summaryContainer) els.summaryContainer.classList.toggle('hidden', !p.summary);
    if (els.linkedinContainer) els.linkedinContainer.classList.toggle('hidden', !p.linkedin);
    if (els.githubContainer) els.githubContainer.classList.toggle('hidden', !p.github);
    if (els.portfolioContainer) els.portfolioContainer.classList.toggle('hidden', !p.portfolio);
  });
</script>
