---
// VolunteerExperienceForm.astro
---

<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
  <div class="flex justify-between items-center mb-6">
    <h2 class="text-xl font-semibold text-gray-800">Pengalaman Sukarelawan (Volunteer)</h2>
  </div>
  
  <form id="volunteerForm" class="space-y-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <!-- Role -->
      <div class="space-y-1.5 cursor-pointer">
        <label for="volRole" class="block text-sm font-medium text-gray-700 cursor-pointer">Peran / Jabatan</label>
        <input 
          type="text" 
          id="volRole" 
          name="role" 
          placeholder="Mentor Pemrograman" 
          class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" 
          required 
        />
      </div>

      <!-- Organization Name -->
      <div class="space-y-1.5 cursor-pointer">
        <label for="volOrgName" class="block text-sm font-medium text-gray-700 cursor-pointer">Nama Organisasi / Acara</label>
        <input 
          type="text" 
          id="volOrgName" 
          name="organization" 
          placeholder="Coding for Indonesia" 
          class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" 
          required 
        />
      </div>

      <!-- Start Date -->
      <div class="space-y-1.5 cursor-pointer">
        <label for="volStartDate" class="block text-sm font-medium text-gray-700 cursor-pointer">Bulan Mulai</label>
        <input 
          type="month" 
          id="volStartDate" 
          name="startDate" 
          class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" 
          required 
        />
      </div>

      <!-- End Date -->
      <div class="space-y-1.5 cursor-pointer">
        <label for="volEndDate" class="block text-sm font-medium text-gray-700 cursor-pointer">Bulan Selesai</label>
        <input 
          type="month" 
          id="volEndDate" 
          name="endDate" 
          class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" 
          required 
        />
      </div>
    </div>

    <!-- Description -->
    <div class="space-y-1.5 cursor-pointer">
      <label for="volDesc" class="block text-sm font-medium text-gray-700 cursor-pointer">Deskripsi Kegiatan</label>
      <textarea 
        id="volDesc" 
        name="description" 
        rows="4" 
        placeholder="Membimbing 15 peserta bootcamp dalam mempelajari dasar-dasar web development..." 
        class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none resize-y leading-relaxed" 
        required
      ></textarea>
    </div>

    <!-- Submit Button -->
    <div class="pt-4 flex justify-end">
      <button 
        type="submit" 
        class="bg-blue-600 text-white font-medium px-6 py-2.5 rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-500/30 transition-all active:scale-[0.98]"
      >
        Tambah Pengalaman Sukarelawan
      </button>
    </div>
  </form>
</div>

<script>
  import { addToSection } from '../../stores/cvStores';
  import type { VolunteerExperience } from '../../stores/cvStores';

  const form = document.getElementById('volunteerForm');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form as HTMLFormElement);

      const item: VolunteerExperience = {
        role: (fd.get('role') as string) || '',
        organization: (fd.get('organization') as string) || '',
        startDate: (fd.get('startDate') as string) || '',
        endDate: (fd.get('endDate') as string) || '',
        description: (fd.get('description') as string) || '',
      };

      addToSection('volunteerExperience', item);
      (form as HTMLFormElement).reset();
    });
  }
</script>
