---
// VolunteerExperienceForm.astro
---

<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
  <div class="flex justify-between items-center mb-6">
    <h2 class="text-xl font-semibold text-gray-800">Pengalaman Sukarelawan (Volunteer)</h2>
  </div>

  <div id="volEntries" class="space-y-6"></div>

  <div class="pt-4">
    <button type="button" id="addVolBtn" class="w-full border-2 border-dashed border-gray-300 text-gray-500 font-medium px-6 py-3 rounded-lg hover:border-blue-400 hover:text-blue-600 focus:outline-none focus:ring-4 focus:ring-blue-500/20 transition-all active:scale-[0.99] cursor-pointer">
      + Tambah Pengalaman Sukarelawan
    </button>
  </div>
</div>

<template id="volEntryTemplate">
  <div class="vol-entry border border-gray-200 rounded-lg p-5 relative group">
    <button type="button" class="delete-entry-btn absolute top-3 right-3 text-gray-300 hover:text-red-500 transition-colors cursor-pointer" title="Hapus pengalaman ini">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
    </button>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div class="space-y-1.5"><label class="block text-sm font-medium text-gray-700">Peran / Jabatan</label><input type="text" data-field="role" placeholder="Mentor Pemrograman" class="vol-input w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" /></div>
      <div class="space-y-1.5"><label class="block text-sm font-medium text-gray-700">Nama Organisasi / Acara</label><input type="text" data-field="organization" placeholder="Coding for Indonesia" class="vol-input w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" /></div>
      <div class="space-y-1.5"><label class="block text-sm font-medium text-gray-700">Bulan Mulai</label><input type="month" data-field="startDate" class="vol-input w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" /></div>
      <div class="space-y-1.5"><label class="block text-sm font-medium text-gray-700">Bulan Selesai</label><input type="month" data-field="endDate" class="vol-input w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" /></div>
    </div>

    <div class="space-y-1.5 mt-5">
      <label class="block text-sm font-medium text-gray-700">Deskripsi Kegiatan</label>
      <textarea data-field="description" rows="4" placeholder="Membimbing 15 peserta bootcamp dalam mempelajari dasar-dasar web development..." class="vol-input w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none resize-y leading-relaxed"></textarea>
    </div>
  </div>
</template>

<script>
  import { cvStore, updateCVSection } from '../../stores/cvStores';
  import type { VolunteerExperience } from '../../stores/cvStores';

  const container = document.getElementById('volEntries')!;
  const addBtn = document.getElementById('addVolBtn')!;
  const template = document.getElementById('volEntryTemplate') as HTMLTemplateElement;
  let isUpdatingFromStore = false;

  function syncToStore() {
    if (isUpdatingFromStore) return;
    const entries = container.querySelectorAll('.vol-entry');
    const items: VolunteerExperience[] = [];
    entries.forEach(entry => {
      const get = (f: string) => (entry.querySelector(`[data-field="${f}"]`) as HTMLInputElement | HTMLTextAreaElement)?.value || '';
      items.push({ role: get('role'), organization: get('organization'), startDate: get('startDate'), endDate: get('endDate'), description: get('description') });
    });
    updateCVSection('volunteerExperience', items);
  }

  function createEntry(data?: VolunteerExperience): HTMLElement {
    const clone = template.content.cloneNode(true) as DocumentFragment;
    const el = clone.querySelector('.vol-entry') as HTMLElement;
    if (data) {
      const set = (f: string, v: string) => { const i = el.querySelector(`[data-field="${f}"]`) as HTMLInputElement | HTMLTextAreaElement; if (i) i.value = v; };
      set('role', data.role); set('organization', data.organization); set('startDate', data.startDate); set('endDate', data.endDate); set('description', data.description);
    }
    el.querySelector('.delete-entry-btn')!.addEventListener('click', () => { el.remove(); syncToStore(); });
    el.querySelectorAll('.vol-input').forEach(i => { i.addEventListener('input', syncToStore); i.addEventListener('change', syncToStore); });
    return el;
  }

  function renderFromStore(data: VolunteerExperience[]) {
    isUpdatingFromStore = true; container.innerHTML = '';
    if (data.length === 0) container.appendChild(createEntry());
    else data.forEach(item => container.appendChild(createEntry(item)));
    isUpdatingFromStore = false;
  }

  renderFromStore(cvStore.get().volunteerExperience);
  addBtn.addEventListener('click', () => container.appendChild(createEntry()));
</script>
