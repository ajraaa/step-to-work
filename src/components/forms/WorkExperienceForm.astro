---
// WorkExperienceForm.astro
---

<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
  <div class="flex justify-between items-center mb-6">
    <h2 class="text-xl font-semibold text-gray-800">Pengalaman Kerja</h2>
  </div>

  <div id="workEntries" class="space-y-6"></div>

  <!-- Tombol Tambah -->
  <div class="pt-4">
    <button 
      type="button" 
      id="addWorkBtn"
      class="w-full border-2 border-dashed border-gray-300 text-gray-500 font-medium px-6 py-3 rounded-lg hover:border-blue-400 hover:text-blue-600 focus:outline-none focus:ring-4 focus:ring-blue-500/20 transition-all active:scale-[0.99] cursor-pointer"
    >
      + Tambah Pengalaman Kerja
    </button>
  </div>
</div>

<!-- Template tersembunyi untuk satu entry -->
<template id="workEntryTemplate">
  <div class="work-entry border border-gray-200 rounded-lg p-5 relative group" data-index="">
    <!-- Tombol Hapus -->
    <button 
      type="button" 
      class="delete-entry-btn absolute top-3 right-3 text-gray-300 hover:text-red-500 transition-colors cursor-pointer"
      title="Hapus pengalaman ini"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
      </svg>
    </button>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <!-- Job Title -->
      <div class="space-y-1.5 cursor-pointer">
        <label class="block text-sm font-medium text-gray-700 cursor-pointer">Posisi Pekerjaan</label>
        <input 
          type="text" 
          data-field="jobTitle" 
          placeholder="Frontend Developer" 
          class="work-input w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" 
        />
      </div>

      <!-- Company -->
      <div class="space-y-1.5 cursor-pointer">
        <label class="block text-sm font-medium text-gray-700 cursor-pointer">Nama Perusahaan</label>
        <input 
          type="text" 
          data-field="company" 
          placeholder="PT Teknologi Nusantara" 
          class="work-input w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" 
        />
      </div>

      <!-- Location -->
      <div class="space-y-1.5 cursor-pointer md:col-span-2">
        <label class="block text-sm font-medium text-gray-700 cursor-pointer">Lokasi</label>
        <input 
          type="text" 
          data-field="location" 
          placeholder="Jakarta, Indonesia" 
          class="work-input w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" 
        />
      </div>

      <!-- Start Date -->
      <div class="space-y-1.5 cursor-pointer">
        <label class="block text-sm font-medium text-gray-700 cursor-pointer">Bulan Mulai</label>
        <input 
          type="month" 
          data-field="startDate" 
          class="work-input w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" 
        />
      </div>

      <!-- End Date -->
      <div class="space-y-1.5 cursor-pointer">
        <label class="block text-sm font-medium text-gray-700 cursor-pointer">Bulan Selesai</label>
        <input 
          type="month" 
          data-field="endDate" 
          class="work-input end-date-input w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none disabled:opacity-50 disabled:bg-gray-100 disabled:cursor-not-allowed" 
        />
      </div>

      <!-- Is Current Job -->
      <div class="flex items-center space-x-3 md:col-span-2 mt-1">
        <input 
          type="checkbox" 
          data-field="isCurrentJob" 
          class="work-input current-job-cb w-5 h-5 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500/20 focus:ring-2 cursor-pointer transition-all" 
        />
        <label class="text-sm font-medium text-gray-700 cursor-pointer">
          Saya masih bekerja di posisi ini
        </label>
      </div>
    </div>

    <!-- Responsibilities -->
    <div class="space-y-1.5 cursor-pointer mt-5">
      <label class="block text-sm font-medium text-gray-700 cursor-pointer">Tanggung Jawab & Pencapaian</label>
      <p class="text-xs text-gray-500 mb-2">Pisahkan setiap poin dengan baris baru (Enter).</p>
      <div class="ai-toolbar">
        <button type="button" class="ai-btn ai-btn--optimize ai-optimize-btn" title="Ubah deskripsi menjadi bullet point dengan action verbs">
          <svg class="ai-btn__sparkle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l2.4 7.2H22l-6 4.8 2.4 7.2L12 16.4l-6.8 4.8 2.4-7.2-6-4.8h7.6z"/></svg>
          ✨ AI Optimize
        </button>
      </div>
      <textarea 
        data-field="responsibilities" 
        rows="4" 
        placeholder="- Mengembangkan dan memelihara aplikasi web...&#10;- Mengimplementasikan design system..." 
        class="work-input w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none resize-y leading-relaxed" 
      ></textarea>
    </div>
  </div>
</template>

<script>
  import { cvStore, updateCVSection } from '../../stores/cvStores';
  import type { WorkExperience } from '../../stores/cvStores';

  // AI Toast notification helper
  function showAIToast(message: string, type: 'success' | 'error' | 'info' = 'info') {
    let toast = document.getElementById('ai-toast');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'ai-toast';
      document.body.appendChild(toast);
    }
    toast.className = `ai-toast ai-toast--${type}`;
    toast.textContent = message;
    requestAnimationFrame(() => {
      toast!.classList.add('active');
    });
    setTimeout(() => {
      toast!.classList.remove('active');
    }, 3000);
  }

  const container = document.getElementById('workEntries')!;
  const addBtn = document.getElementById('addWorkBtn')!;
  const template = document.getElementById('workEntryTemplate') as HTMLTemplateElement;

  let isUpdatingFromStore = false;

  // ---- Membaca seluruh entry dari DOM lalu sinkronkan ke store ----
  function syncToStore() {
    if (isUpdatingFromStore) return;

    const entries = container.querySelectorAll('.work-entry');
    const items: WorkExperience[] = [];

    entries.forEach((entry) => {
      const get = (field: string) => {
        const el = entry.querySelector(`[data-field="${field}"]`) as HTMLInputElement | HTMLTextAreaElement | null;
        return el?.value || '';
      };
      const isCurrentJob = (entry.querySelector('[data-field="isCurrentJob"]') as HTMLInputElement)?.checked || false;
      const responsibilitiesRaw = get('responsibilities');

      items.push({
        jobTitle: get('jobTitle'),
        company: get('company'),
        location: get('location'),
        startDate: get('startDate'),
        endDate: isCurrentJob ? null : get('endDate'),
        isCurrentJob,
        responsibilities: responsibilitiesRaw
          .split('\n')
          .map(l => l.replace(/^[-•]\s*/, '').trim())
          .filter(Boolean),
      });
    });

    updateCVSection('workExperience', items);
  }

  // ---- Membuat satu entry baru dari template ----
  function createEntry(data?: WorkExperience): HTMLElement {
    const clone = template.content.cloneNode(true) as DocumentFragment;
    const entryEl = clone.querySelector('.work-entry') as HTMLElement;

    // Jika ada data, isi field-field
    if (data) {
      const set = (field: string, value: string) => {
        const el = entryEl.querySelector(`[data-field="${field}"]`) as HTMLInputElement | HTMLTextAreaElement | null;
        if (el) el.value = value;
      };
      set('jobTitle', data.jobTitle);
      set('company', data.company);
      set('location', data.location);
      set('startDate', data.startDate);
      set('endDate', data.endDate || '');

      const cb = entryEl.querySelector('[data-field="isCurrentJob"]') as HTMLInputElement;
      if (cb) cb.checked = data.isCurrentJob;

      const endDateInput = entryEl.querySelector('.end-date-input') as HTMLInputElement;
      if (endDateInput && data.isCurrentJob) {
        endDateInput.disabled = true;
      }

      if (data.responsibilities.length > 0) {
        set('responsibilities', data.responsibilities.map(r => `- ${r}`).join('\n'));
      }
    }

    // Event: hapus entry
    const deleteBtn = entryEl.querySelector('.delete-entry-btn')!;
    deleteBtn.addEventListener('click', () => {
      entryEl.remove();
      syncToStore();
    });

    // Event: checkbox "masih bekerja" → disable/enable end date
    const cb = entryEl.querySelector('.current-job-cb') as HTMLInputElement;
    const endDate = entryEl.querySelector('.end-date-input') as HTMLInputElement;
    cb.addEventListener('change', () => {
      endDate.disabled = cb.checked;
      if (cb.checked) endDate.value = '';
      syncToStore();
    });

    // Event: semua input → sync real-time
    entryEl.querySelectorAll('.work-input').forEach(input => {
      input.addEventListener('input', syncToStore);
      input.addEventListener('change', syncToStore); // untuk checkbox & month input
    });

    // Event: AI Optimize button
    const aiOptBtn = entryEl.querySelector('.ai-optimize-btn');
    const responsibilitiesTA = entryEl.querySelector('[data-field="responsibilities"]') as HTMLTextAreaElement;
    const jobTitleInput = entryEl.querySelector('[data-field="jobTitle"]') as HTMLInputElement;
    
    aiOptBtn?.addEventListener('click', async () => {
      const text = responsibilitiesTA?.value?.trim();
      if (!text) {
        showAIToast('Tulis deskripsi pekerjaan terlebih dahulu!', 'error');
        return;
      }
      
      aiOptBtn.classList.add('ai-btn--loading');
      const originalLabel = aiOptBtn.innerHTML;
      aiOptBtn.innerHTML = `<svg class="ai-btn__sparkle ai-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4m0 12v4m-7.07-3.93l2.83-2.83m8.48-8.48l2.83-2.83M2 12h4m12 0h4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83"/></svg> Optimizing...`;
      
      try {
        const res = await fetch('/api/ai/optimize-bullet', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            text,
            jobTitle: jobTitleInput?.value || '',
          }),
        });
        const data = await res.json();
        
        if (data.error) {
          showAIToast(data.error, 'error');
        } else if (data.result) {
          responsibilitiesTA.value = data.result;
          responsibilitiesTA.dispatchEvent(new Event('input', { bubbles: true }));
          showAIToast('Bullet points berhasil dioptimasi! ✨', 'success');
        }
      } catch (err) {
        showAIToast('Gagal menghubungi AI. Coba lagi nanti.', 'error');
      } finally {
        aiOptBtn.classList.remove('ai-btn--loading');
        aiOptBtn.innerHTML = originalLabel;
      }
    });

    return entryEl;
  }

  // ---- Render dari store saat pertama kali load ----
  function renderFromStore(data: WorkExperience[]) {
    isUpdatingFromStore = true;
    container.innerHTML = '';

    if (data.length === 0) {
      // Tampilkan satu entry kosong secara default
      container.appendChild(createEntry());
    } else {
      data.forEach(item => {
        container.appendChild(createEntry(item));
      });
    }
    isUpdatingFromStore = false;
  }

  // ---- Inisialisasi: render dari data store yang sudah ada ----
  const initialData = cvStore.get();
  renderFromStore(initialData.workExperience);

  // ---- Tombol tambah ----
  addBtn.addEventListener('click', () => {
    container.appendChild(createEntry());
  });
</script>
