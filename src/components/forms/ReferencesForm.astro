---
// ReferencesForm.astro
---

<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
  <div class="flex justify-between items-center mb-6">
    <h2 class="text-xl font-semibold text-gray-800">Referensi</h2>
  </div>
  
  <form class="space-y-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <!-- Name -->
      <div class="space-y-1.5 cursor-pointer">
        <label for="refName" class="block text-sm font-medium text-gray-700 cursor-pointer">Nama Lengkap</label>
        <input 
          type="text" 
          id="refName" 
          name="name" 
          placeholder="Budi Santoso" 
          class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" 
          required 
        />
      </div>

      <!-- Job Title -->
      <div class="space-y-1.5 cursor-pointer">
        <label for="refJobTitle" class="block text-sm font-medium text-gray-700 cursor-pointer">Posisi / Jabatan</label>
        <input 
          type="text" 
          id="refJobTitle" 
          name="jobTitle" 
          placeholder="Engineering Manager" 
          class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" 
          required 
        />
      </div>

      <!-- Company -->
      <div class="space-y-1.5 cursor-pointer">
        <label for="refCompany" class="block text-sm font-medium text-gray-700 cursor-pointer">Perusahaan / Institusi</label>
        <input 
          type="text" 
          id="refCompany" 
          name="company" 
          placeholder="PT Teknologi Nusantara" 
          class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" 
          required 
        />
      </div>

      <!-- Relationship -->
      <div class="space-y-1.5 cursor-pointer">
        <label for="refRelationship" class="block text-sm font-medium text-gray-700 cursor-pointer">Hubungan</label>
        <input 
          type="text" 
          id="refRelationship" 
          name="relationship" 
          placeholder="Direct Supervisor, Co-worker, dsb." 
          class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" 
          required 
        />
      </div>

      <!-- Email -->
      <div class="space-y-1.5 cursor-pointer">
        <label for="refEmail" class="block text-sm font-medium text-gray-700 cursor-pointer">Email</label>
        <input 
          type="email" 
          id="refEmail" 
          name="email" 
          placeholder="budi.santoso@example.com" 
          class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" 
          required 
        />
      </div>

      <!-- Phone -->
      <div class="space-y-1.5 cursor-pointer">
        <label for="refPhone" class="block text-sm font-medium text-gray-700 cursor-pointer">Telepon</label>
        <input 
          type="tel" 
          id="refPhone" 
          name="phone" 
          placeholder="+62 813-0000-0000" 
          class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" 
          required 
        />
      </div>
    </div>

    <!-- Submit Button -->
    <div class="pt-4 flex justify-end">
      <button 
        type="submit" 
        class="bg-blue-600 text-white font-medium px-6 py-2.5 rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-500/30 transition-all active:scale-[0.98]"
      >
        Tambah Referensi
      </button>
    </div>
  </form>
</div>
