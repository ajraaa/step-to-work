---
// ProjectsForm.astro
---

<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
  <div class="flex justify-between items-center mb-6">
    <h2 class="text-xl font-semibold text-gray-800">Proyek</h2>
  </div>
  
  <form id="projectsForm" class="space-y-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <!-- Project Name -->
      <div class="space-y-1.5 cursor-pointer">
        <label for="projectName" class="block text-sm font-medium text-gray-700 cursor-pointer">Nama Proyek</label>
        <input 
          type="text" 
          id="projectName" 
          name="name" 
          placeholder="E-Commerce Dashboard" 
          class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" 
          required 
        />
      </div>

      <!-- Project URL -->
      <div class="space-y-1.5 cursor-pointer">
        <label for="projectUrl" class="block text-sm font-medium text-gray-700 cursor-pointer">URL Proyek (Opsional)</label>
        <input 
          type="url" 
          id="projectUrl" 
          name="url" 
          placeholder="https://github.com/azzra/ecommerce-dashboard" 
          class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" 
        />
      </div>

      <!-- Description -->
      <div class="space-y-1.5 cursor-pointer md:col-span-2">
        <label for="projectDesc" class="block text-sm font-medium text-gray-700 cursor-pointer">Deskripsi Singkat</label>
        <textarea 
          id="projectDesc" 
          name="description" 
          rows="2" 
          placeholder="Dashboard analytics untuk platform e-commerce dengan visualisasi data penjualan real-time..." 
          class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none resize-y leading-relaxed" 
          required
        ></textarea>
      </div>

      <!-- Tech Stack -->
      <div class="space-y-1.5 cursor-pointer md:col-span-2">
        <label for="techStack" class="block text-sm font-medium text-gray-700 cursor-pointer">Tech Stack</label>
        <p class="text-xs text-gray-500 mb-1">Pisahkan dengan koma (,).</p>
        <input 
          type="text" 
          id="techStack" 
          name="techStack" 
          placeholder="Next.js, TypeScript, Recharts, Tailwind CSS" 
          class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" 
          required 
        />
      </div>

      <!-- Highlights -->
      <div class="space-y-1.5 cursor-pointer md:col-span-2">
        <label for="highlights" class="block text-sm font-medium text-gray-700 cursor-pointer">Pencapaian / Fitur Utama (Highlights)</label>
        <p class="text-xs text-gray-500 mb-1">Pisahkan setiap poin dengan baris baru (Enter).</p>
        <textarea 
          id="highlights" 
          name="highlights" 
          rows="4" 
          placeholder="- Menangani 10.000+ data transaksi dengan lazy loading...&#10;- Mengimplementasikan filter dan export laporan..." 
          class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none resize-y leading-relaxed" 
          required
        ></textarea>
      </div>
    </div>

    <!-- Submit Button -->
    <div class="pt-4 flex justify-end">
      <button 
        type="submit" 
        class="bg-blue-600 text-white font-medium px-6 py-2.5 rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-500/30 transition-all active:scale-[0.98]"
      >
        Tambah Proyek
      </button>
    </div>
  </form>
</div>

<script>
  import { addToSection } from '../../stores/cvStores';
  import type { Project } from '../../stores/cvStores';

  const form = document.getElementById('projectsForm');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form as HTMLFormElement);

      const item: Project = {
        name: (fd.get('name') as string) || '',
        description: (fd.get('description') as string) || '',
        techStack: ((fd.get('techStack') as string) || '').split(',').map(s => s.trim()).filter(Boolean),
        highlights: ((fd.get('highlights') as string) || '').split('\n').map(l => l.replace(/^[-•]\s*/, '').trim()).filter(Boolean),
        url: (fd.get('url') as string) || '',
      };

      addToSection('projects', item);
      (form as HTMLFormElement).reset();
    });
  }
</script>
