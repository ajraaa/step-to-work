---
// src/components/ui/TabSwitcher.astro
---
<div class="flex items-center gap-1 bg-gray-100 p-1 rounded-xl self-start w-fit border border-gray-200/50">
  <button id="tab-content" class="px-6 py-2 text-xs font-bold rounded-lg transition-all duration-300 text-white bg-blue-600 shadow-md shadow-blue-200">
    Content
  </button>
  <button id="tab-customize" class="px-6 py-2 text-xs font-bold rounded-lg transition-all duration-300 text-gray-500 hover:text-gray-700">
    Styling
  </button>
</div>

<script>
  import { activeTabStore } from '../../stores/uiStore';

  const btnContent = document.getElementById('tab-content');
  const btnCustomize = document.getElementById('tab-customize');

  function updateActiveStyles(activeTab: 'content' | 'customize') {
    const activeClasses = ['bg-blue-600', 'text-white', 'shadow-md', 'shadow-blue-200'];
    const inactiveClasses = ['text-gray-500', 'hover:text-gray-700'];

    if (activeTab === 'content') {
      btnContent?.classList.add(...activeClasses);
      btnContent?.classList.remove(...inactiveClasses);
      
      btnCustomize?.classList.remove(...activeClasses);
      btnCustomize?.classList.add(...inactiveClasses);
    } else {
      btnCustomize?.classList.add(...activeClasses);
      btnCustomize?.classList.remove(...inactiveClasses);
      
      btnContent?.classList.remove(...activeClasses);
      btnContent?.classList.add(...inactiveClasses);
    }
  }

  // Subscribe to store changes to update button styling
  activeTabStore.subscribe((value) => {
    updateActiveStyles(value);
  });

  btnContent?.addEventListener('click', () => {
    activeTabStore.set('content');
  });

  btnCustomize?.addEventListener('click', () => {
    activeTabStore.set('customize');
  });
</script>
